# مفاتيح Supabase — انسخ هذا الملف إلى .env.local واملأ القيمتين.
#
#   cp .env.local.example .env.local
#
# مصدر القيمتين: Supabase Dashboard → Project Settings → Data API
#
# ⚠️  مفتاح service_role لا يوضع هنا ولا في الكود أبداً. المطلوب anon فقط،
#     وهو مصمَّم ليكون علنياً ومحمي بسياسات RLS في supabase/schema.sql.
#
# التطبيق يعمل بدون هذا الملف — بالهوية الافتراضية وبلا تسجيل دخول.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
